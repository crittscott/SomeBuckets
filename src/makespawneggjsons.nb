Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ExtractJSONFiles", "[", "filename_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "content", ",", "lines", ",", "currentPath", ",", "currentJSON", ",", 
       "inJSON", ",", "processFile"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Read", " ", "the", " ", "file", " ", "content"}], "*)"}], 
     RowBox[{
      RowBox[{"content", "=", 
       RowBox[{"Import", "[", 
        RowBox[{"filename", ",", "\"\<Text\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lines", "=", 
       RowBox[{"StringSplit", "[", 
        RowBox[{"content", ",", "\"\<\\n\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Initialize", " ", "variables"}], "*)"}], 
      RowBox[{"currentPath", "=", "\"\<\>\""}], ";", "\[IndentingNewLine]", 
      RowBox[{"currentJSON", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"inJSON", "=", "False"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Function", " ", "to", " ", "process", " ", "and", " ", "write", " ", 
        "current", " ", "file"}], "*)"}], 
      RowBox[{
       RowBox[{"processFile", "[", "]"}], ":=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"currentPath", "!=", "\"\<\>\""}], "&&", 
          RowBox[{
           RowBox[{"Length", "[", "currentJSON", "]"}], ">", "0"}]}], ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"filePath", ",", "jsonText", ",", "dir"}], "}"}], ",", 
           RowBox[{
            RowBox[{"filePath", "=", "currentPath"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"jsonText", "=", 
             RowBox[{"StringRiffle", "[", 
              RowBox[{"currentJSON", ",", "\"\<\\n\>\""}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Create", " ", "directory", " ", "if", " ", "it", " ", 
              RowBox[{"doesn", "'"}], "t", " ", "exist"}], "*)"}], 
            RowBox[{"dir", "=", 
             RowBox[{"DirectoryName", "[", "filePath", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"dir", "!=", "\"\<\>\""}], ",", 
              RowBox[{"Quiet", "[", 
               RowBox[{"CreateDirectory", "[", 
                RowBox[{"dir", ",", 
                 RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], 
                "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Write", " ", "JSON", " ", "file"}], "*)"}], 
            RowBox[{"Export", "[", 
             RowBox[{"filePath", ",", "jsonText", ",", "\"\<Text\>\""}], 
             "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Created: \>\"", "<>", "filePath"}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Reset", " ", "for", " ", "next", " ", "file"}], "*)"}], 
            RowBox[{"currentJSON", "=", 
             RowBox[{"{", "}"}]}], ";"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Process", " ", "each", " ", "line"}], "*)"}], 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Which", "[", 
         RowBox[{"(*", 
          RowBox[{
          "Check", " ", "if", " ", "line", " ", "is", " ", "a", " ", 
           "header"}], "*)"}], 
         RowBox[{
          RowBox[{"StringMatchQ", "[", 
           RowBox[{"line", ",", 
            
            RowBox[{"\"\<// ========== \>\"", "~~", "___", 
             "~~", "\"\< ==========\>\""}]}], "]"}], ",", 
          RowBox[{"(", 
           RowBox[{"(*", 
            RowBox[{
            "Process", " ", "previous", " ", "file", " ", "if", " ", 
             "exists"}], "*)"}], 
           RowBox[{
            RowBox[{"processFile", "[", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Extract", " ", "new", " ", "file", " ", "path"}], 
             "*)"}], 
            RowBox[{"currentPath", "=", 
             RowBox[{
              RowBox[{"StringCases", "[", 
               RowBox[{"line", ",", 
                RowBox[{
                 
                 RowBox[{"\"\<// ========== \>\"", "~~", "path__", 
                  "~~", "\"\< ==========\>\""}], ":>", "path"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"inJSON", "=", "True"}], ";"}], ")"}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "Check", " ", "if", " ", "line", " ", "starts", " ", "with"}], "//", 
            RowBox[{
             RowBox[{"(", "comment", ")"}], "-", 
             RowBox[{"skip", " ", "it"}]}]}], "*)"}], 
          RowBox[{"StringMatchQ", "[", 
           RowBox[{"line", ",", 
            RowBox[{"\"\<// \>\"", "~~", "___"}]}], "]"}], ",", "Null", ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"If", " ", 
             RowBox[{"we", "'"}], "re", " ", "in", " ", "a", " ", "JSON", " ",
              "section", " ", "and", " ", "line", " ", "is", " ", "not", " ", 
             "a", " ", "comment"}], ",", 
            RowBox[{"collect", " ", "it"}]}], "*)"}], "inJSON", ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"currentJSON", ",", "line"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"line", ",", "lines"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Process", " ", "the", " ", "final", " ", "file"}], "*)"}], 
      RowBox[{"processFile", "[", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Extraction complete!\>\"", "]"}], ";"}]}], 
    "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Usage", " ", 
    RowBox[{"example", ":"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"ExtractJSONFiles", "[", "\"\<jsons.txt\>\"", "]"}], 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9667749150730915`*^9, 3.9667749150730915`*^9}, 
   3.9667749457917767`*^9, 3.966774991519705*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"158f61f4-3639-b24d-be48-28d24d8aeac4"],

